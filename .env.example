# Ustawienia strony — skopiuj do .env.local (lokalnie) lub ustaw w Vercel → Settings → Environment Variables

# Publiczny URL strony (bez trailing slash)
SITE_URL=https://twoja-domena.pl

# Imię i nazwisko autora — pojawia się w tytułach stron i metadanych OG
AUTHOR_NAME=Imię Nazwisko

# Pełna nazwa administratora danych wyświetlana w polityce prywatności (tylko serwer)
PRIVACY_ADMIN_NAME=Nazwa firmy — Imię i nazwisko

# Publiczne treści strony (dostępne też w komponentach client-side)
NEXT_PUBLIC_SITE_DESCRIPTION=Portfolio fotografa i operatora wideo — wydarzenia militarne, survival, drony, off-road, śluby i sesje rodzinne.
NEXT_PUBLIC_STRUCTURED_DATA_DESCRIPTION=Fotografia i film — wydarzenia militarne, survival, drony, off-road, śluby i sesje rodzinne.
NEXT_PUBLIC_HERO_HEADLINE_LINE_1=Zamrażam
NEXT_PUBLIC_HERO_HEADLINE_LINE_2=Chwile
NEXT_PUBLIC_HERO_SUBTITLE=Fotografia i film — wydarzenia militarne, drony, ślub, off-road i sesje rodzinne.
NEXT_PUBLIC_HERO_CTA_LABEL=Skontaktuj się

# Publiczne dane kontaktowe i profilowe. Zmienne NEXT_PUBLIC_ są widoczne w przeglądarce.
NEXT_PUBLIC_HERO_CTA_HREF=tel:+48000000000
NEXT_PUBLIC_CTA_HREF=mailto:kontakt@example.com
NEXT_PUBLIC_CTA_PHONE_HREF=tel:+48000000000
NEXT_PUBLIC_ABOUTME_PHONE=+48 000 000 000
NEXT_PUBLIC_ABOUTME_EMAIL=kontakt@example.com
NEXT_PUBLIC_ABOUTME_CTA_HREF=mailto:kontakt@example.com
NEXT_PUBLIC_ABOUTME_HERO_NAME=Imię i nazwisko
NEXT_PUBLIC_ABOUT_STATEMENT=Krótki opis autora
NEXT_PUBLIC_ABOUTME_PROFILE_INTRO=Opis autora

# Publiczne profile społecznościowe
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/twoj-profil
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/twoj-profil/
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@twoj-kanal
NEXT_PUBLIC_SOCIAL_MESSENGER=https://m.me/twoj-profil
NEXT_PUBLIC_SOCIAL_WHATSAPP=https://wa.me/48000000000
